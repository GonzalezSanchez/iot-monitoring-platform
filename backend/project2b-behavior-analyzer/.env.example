# ────────────────────────────────────────────────
# Project 2b — Behavior Pattern Analyzer
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────

# PostgreSQL — used only by analyze.py (serving layer for Power BI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p2b_dev
DB_USER=p2b_admin
DB_PASSWORD=dev

# PostgreSQL — production
DB_HOST_PROD=
DB_PORT_PROD=5432
DB_NAME_PROD=p2b_prod
DB_USER_PROD=
DB_PASSWORD_PROD=

# AWS — required when running via Docker (Airflow container has no ~/.aws)
AWS_REGION=eu-central-1
DYNAMODB_TABLE=prod-SensorEvents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Spark
SPARK_MASTER=local[*]

# S3 — data lake layers (extract writes raw, transform reads raw + writes processed)
S3_PARQUET_PATH=s3a://<bucket>/raw/
S3_PROCESSED_PATH=s3a://<bucket>/processed/

# Logging
LOG_LEVEL=INFO

# Observability — Grafana Cloud via OTel Collector
# GRAFANA_OTLP_ENDPOINT: from Grafana Cloud → My Account → OpenTelemetry
# GRAFANA_OTLP_TOKEN: base64(instanceId:apiKey)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_OTLP_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
