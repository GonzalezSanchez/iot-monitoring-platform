# ────────────────────────────────────────────────
# Project 2b — Behavior Pattern Analyzer
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────

# PostgreSQL — local development (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p2b_dev
DB_USER=p2b_admin
DB_PASSWORD=dev

# PostgreSQL — production (RDS)
DB_HOST_PROD=
DB_PORT_PROD=5432
DB_NAME_PROD=p2b_prod
DB_USER_PROD=
DB_PASSWORD_PROD=

# S3 / MinIO (local mock)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sensor-events

# Logging
LOG_LEVEL=INFO
