{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Project 2b — Behavior Pipeline",
  "uid": "p2b-pipeline",
  "tags": ["project2b", "airflow", "pyspark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Last pipeline run",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Records scanned",
      "description": "DynamoDB items read by the extract job in the most recent run",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_extract_records_scanned.*\"}",
          "legendFormat": "scanned",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Records processed",
      "description": "Validated records written by the transform job",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_transform_records_processed.*\"}",
          "legendFormat": "processed",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Records dropped",
      "description": "Invalid records removed during validation",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 1 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_transform_records_dropped.*\"}",
          "legendFormat": "dropped",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Anomalies detected",
      "description": "Z-score + occupancy anomalies found by the analyze job",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 1 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_analyze_anomalies_detected.*\"}",
          "legendFormat": "anomalies",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Patterns detected",
      "description": "Occupancy schedules + temperature trends found by the analyze job",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_analyze_patterns_detected.*\"}",
          "legendFormat": "patterns",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Runs over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Task duration per run",
      "description": "Airflow StatsD timing per pipeline task — each cluster of points is one run",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "airflow_dag_behavior_pipeline_extract_duration",
          "legendFormat": "extract",
          "refId": "A"
        },
        {
          "expr": "airflow_dag_behavior_pipeline_transform_duration",
          "legendFormat": "transform",
          "refId": "B"
        },
        {
          "expr": "airflow_dag_behavior_pipeline_analyze_duration",
          "legendFormat": "analyze",
          "refId": "C"
        },
        {
          "expr": "airflow_dag_behavior_pipeline_spatial_duration",
          "legendFormat": "spatial",
          "refId": "D"
        },
        {
          "expr": "airflow_dag_behavior_pipeline_dbt_run_duration",
          "legendFormat": "dbt_run",
          "refId": "E"
        },
        {
          "expr": "airflow_dag_behavior_pipeline_manage_partitions_duration",
          "legendFormat": "manage_partitions",
          "refId": "F"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "spanNulls": false,
            "showPoints": "always",
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pipeline results per run",
      "description": "Custom OTel counters emitted by the PySpark jobs — one point per run",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "{__name__=~\"p2b_extract_records_scanned.*\"}",
          "legendFormat": "records scanned",
          "refId": "A"
        },
        {
          "expr": "{__name__=~\"p2b_transform_records_processed.*\"}",
          "legendFormat": "records processed",
          "refId": "B"
        },
        {
          "expr": "{__name__=~\"p2b_analyze_anomalies_detected.*\"}",
          "legendFormat": "anomalies",
          "refId": "C"
        },
        {
          "expr": "{__name__=~\"p2b_analyze_patterns_detected.*\"}",
          "legendFormat": "patterns",
          "refId": "D"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "spanNulls": false,
            "showPoints": "always",
            "lineWidth": 0,
            "scaleDistribution": { "type": "log", "log": 10 }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Scheduler health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "DAG parse time",
      "description": "Airflow scheduler — time to parse the DAG file",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "airflow_dag_processing_last_duration_behavior_pipeline",
          "legendFormat": "parse time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Executor slots",
      "description": "Open vs running slots on the LocalExecutor",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "airflow_executor_open_slots",
          "legendFormat": "open",
          "refId": "A"
        },
        {
          "expr": "airflow_executor_running_tasks",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "airflow_executor_queued_tasks",
          "legendFormat": "queued",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
