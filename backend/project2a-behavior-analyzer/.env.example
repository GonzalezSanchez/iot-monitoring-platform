# ────────────────────────────────────────────────
# Project 2a — Behavior Pattern Analyzer
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────

# AWS region
AWS_REGION=eu-central-1

# AWS credentials
# For local dev with moto mocks: any dummy value works
# For real AWS: use an IAM user with least-privilege policies
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB source table (project 1a — read only)
DYNAMODB_TABLE_EVENTS=prod-SensorEvents

# Aurora PostgreSQL — local development (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p2_dev
DB_USER=dev
DB_PASSWORD=dev

# Aurora PostgreSQL — production (via Secrets Manager)
# In AWS Lambda: leave empty, credentials are fetched from Secrets Manager
SECRETS_MANAGER_SECRET_NAME=p2-prod-db-credentials

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
