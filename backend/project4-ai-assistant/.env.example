# Anthropic API key — create at console.anthropic.com (prepaid credits are the
# spend cap). Never commit the real key; production value lives in .env.prod
# on the server only.
ANTHROPIC_API_KEY=sk-ant-...

# MCP endpoint of project 1b (internal Docker network name in production)
MCP_SERVER_URL=http://backend:8000/mcp

# Cost/abuse limits — see docs/project4-prd.md §8 and the public spec
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=20
MAX_TOKENS=1024
MAX_HISTORY_MESSAGES=6
MAX_STEPS=8
MAX_INPUT_CHARS=2000
