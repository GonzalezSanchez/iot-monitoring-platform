# ────────────────────────────────────────────────────────────────
# Project 2c — Azure Databricks Lakehouse + dbt
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────────────────────

# Azure — storage account for ADLS Gen2 (Bronze/Silver/Gold)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_BRONZE=bronze
AZURE_STORAGE_CONTAINER_SILVER=silver
AZURE_STORAGE_CONTAINER_GOLD=gold

# Databricks workspace
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=

# Databricks SQL Warehouse — used by dbt-databricks and Power BI
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Databricks SQL Warehouse (production)
DATABRICKS_HOST_PROD=
DATABRICKS_HTTP_PATH_PROD=
DATABRICKS_TOKEN_PROD=

# Logging
LOG_LEVEL=INFO
