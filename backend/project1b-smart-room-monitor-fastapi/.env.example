# ────────────────────────────────────────────────
# Project 1b — Smart Room Monitor (FastAPI)
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────

# AWS region
AWS_REGION=eu-central-1

# DynamoDB endpoint — only needed for local development (DynamoDB Local)
# Leave empty (or remove) when running against real AWS
AWS_ENDPOINT_URL=http://localhost:8001

# AWS credentials
# For DynamoDB Local: any dummy value works
# For real AWS: use an IAM user with least-privilege policies
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB table names
DYNAMODB_TABLE_ROOMS=RoomStatus
DYNAMODB_TABLE_EVENTS=SensorEvents

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Datadog — OTel Collector exports to datadoghq.eu
# Get from: datadoghq.eu → Organization Settings → API Keys
DD_API_KEY=your_datadog_api_key_here

# OpenTelemetry — configure the backend exporter
OTEL_SERVICE_NAME=iot-smart-room-monitor
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=1.0.0
