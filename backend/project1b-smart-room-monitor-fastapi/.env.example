# ────────────────────────────────────────────────
# Project 1b — Smart Room Monitor (FastAPI)
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example is tracked.
# ────────────────────────────────────────────────

# AWS region
AWS_REGION=eu-central-1

# DynamoDB endpoint — only needed for local development (DynamoDB Local)
# Leave empty (or remove) when running against real AWS
AWS_ENDPOINT_URL=http://localhost:8001

# AWS credentials
# For DynamoDB Local: any dummy value works
# For real AWS: use an IAM user with least-privilege policies
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB table names
DYNAMODB_TABLE_ROOMS=RoomStatus
DYNAMODB_TABLE_EVENTS=SensorEvents

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
