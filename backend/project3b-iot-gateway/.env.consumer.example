# Consumer (normalizer) — separate least-privilege AWS user from the gateway:
# iot-gateway-consumer can only write prod-SensorEvents / prod-RoomStatus.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
TOPIC_SENSOR_EVENTS=sensor-events
TOPIC_DLQ=sensor-events.dlq
CONSUMER_GROUP=gateway-normalizer

# Shared contract tables (owned by project 1b)
SENSOR_EVENTS_TABLE=prod-SensorEvents
ROOM_STATUS_TABLE=prod-RoomStatus
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
